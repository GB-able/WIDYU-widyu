<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/medication_alarm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6151515"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/medication_alarm_logo"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="5" />

    <ImageView
        android:id="@+id/medication_alarm_mascot"
        android:layout_width="93dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="약을 든 위듀 캐릭터" />

    <TextView
        android:id="@+id/medication_alarm_dose"
        style="@style/MedicationAlarmText"
        android:layout_marginTop="12dp"
        android:textAppearance="@style/Typo.Title1"
        android:textColor="@color/primary" />

    <TextView
        android:id="@+id/medication_alarm_message"
        style="@style/MedicationAlarmText"
        android:layout_marginTop="4dp"
        android:text="복용하실 시간이에요!"
        android:textAppearance="@style/Typo.SubTitle6"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/medication_alarm_verify"
        style="@style/MedicationAlarmButton"
        android:layout_width="234dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/alarm_verify_button"
        android:text="인증 하러 가기"
        android:textAppearance="@style/Typo.Title3" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="8" />

    <Button
        android:id="@+id/medication_alarm_stop"
        style="@style/MedicationAlarmButton"
        android:layout_width="95dp"
        android:layout_height="41dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/alarm_stop_button"
        android:text="중단"
        android:textAppearance="@style/Typo.SubTitle2" />
</LinearLayout>
